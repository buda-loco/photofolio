  "info": {
    "about": {
      "type": "root",
      "children": [
        {
          "children": [
            {
              "text": "MusicACT is the ACT's peak body for contemporary music, a non-profit working on professional development, policy and industry growth across the Canberra region. It operates behind the scenes on behalf of artists, and the rebrand had to read that way: present, without competing with the people it represents."
            }
          ],
          "type": "p",
          "id": "BBSaO5sBIV"
        },
        {
          "type": "p",
          "id": "bi1gkrLkKQ",
          "children": [
            {
              "text": "The identity comes out of one idea: soundwaves drawn entirely with line weight. Vary the width and rhythm of the lines and the logotype appears inside the waveform, so the music is visible without being illustrated. MusicACT amplifies artists rather than performing, and the mark keeps the same restraint."
            }
          ]
        },
        {
          "type": "p",
          "id": "yj5qleHUzE",
          "children": [
            {
              "text": "It runs across a full design system: social graphics, stationery, the website, and the visual language for their annual awards."
            }
          ]
        }
      ]
    },
    "date": "2021",
    "place": "Canberra, ACT",
    "client": "Music ACT"
  },
