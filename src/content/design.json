{
  "_note": "Edit this file to change the visual design. Run npm run build after saving.",

  "colors": {
    "background":  "#000000",
    "text":        "#ffffff",
    "textMuted":   "#666666",
    "textBright":  "#ffffff",
    "border":      "rgba(255, 255, 255, 0.1)",
    "labelColor":  "#f4ff26"
  },

  "typography": {
    "sans":    "'Adrianna', system-ui, -apple-system, sans-serif",
    "display": "'Adrianna Extended', system-ui, sans-serif",

    "headings": {
      "weight":        "700",
      "letterSpacing": "0.01em",
      "lineHeight":    "1.05"
    },

    "labels": {
      "size":          "0.6875rem",
      "letterSpacing": "0.15em"
    },

    "body": {
      "size":       "0.8125rem",
      "lineHeight": "1.8"
    }
  },

  "textBlock": {
    "_note": "Controls the 'text' block type inside project pages",
    "headingSize":          "clamp(2.5rem, 5vw, 5.5rem)",
    "headingWeight":        "300",
    "headingLetterSpacing": "0em",
    "headingLineHeight":    "1.0",
    "bodySize":             "1rem",
    "bodyLineHeight":       "1.85",
    "maxWidth":             "52ch",
    "gap":                  "2.5rem"
  },

  "buttons": {
    "fontSize":      "0.6875rem",
    "letterSpacing": "0.15em",
    "paddingV":      "0.7rem",
    "paddingH":      "1.75rem"
  }
}
