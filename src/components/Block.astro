---
const { block } = Astro.props
// Tina CMS uses _template as the block discriminator; fall back to type for
// existing JSON files that haven't been touched by Tina yet.
const blockType: string = block._template ?? block.type

function dropboxUrl(src: string): string {
  if (!src?.includes('dropbox.com')) return src
  const base = src.replace(/[?&]dl=\d/, '').replace(/\?$/, '')
  return base + (src.includes('?') ? '&raw=1' : '?raw=1')
}

// Split heading into individual word spans for clip-mask animation
function splitWords(text: string) {
  return text.split(' ')
}

// Build a OneLinePlayer iframe src from a video URL + options
function onelinerSrc(url: string, opts: Record<string, string> = {}): string {
  const params = new URLSearchParams({
    url,
    autoplay:        opts.autoplay        ?? 'false',
    autopause:       'true',
    muted:           opts.muted           ?? 'false',
    loop:            opts.loop            ?? 'false',
    progressBar:     'true',
    overlay:         'true',
    muteButton:      'true',
    fullscreenButton:'true',
    style:           'dark',
    quality:         'auto',
    playButton:      'true',
    ...(opts.poster  ? { poster: opts.poster } : {}),
  })
  return `https://onelineplayer.com/player.html?${params}`
}
---

{blockType === 'hero' && (
  <div class="block-hero img-reveal" style={block.aspectRatio ? `--aspect: ${block.aspectRatio}` : undefined}>
    <div class="img-container">
      <img
        src={block.src}
        alt={block.alt ?? ''}
        loading="lazy"
        decoding="async"
        data-parallax={block.parallax ?? undefined}
      />
    </div>
    {block.caption && <p class="block-caption label">{block.caption}</p>}
  </div>
)}

{blockType === 'gallery' && (
  <div class="block-gallery" data-cols={String(block.columns ?? 2)}>
    {block.images.map((img: any) => (
      <div class="gallery-item img-reveal" style={img.aspectRatio ? `--aspect: ${img.aspectRatio}` : undefined}>
        <div class="img-container">
          <img
            src={img.src}
            alt={img.alt ?? ''}
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    ))}
  </div>
)}

{blockType === 'video' && (
  <div class="block-video">
    <div class="video-container">
      {block.provider === 'youtube' ? (
        <iframe
          src={`https://www.youtube.com/embed/${block.id}?rel=0`}
          title={block.caption ?? 'Project video'}
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      ) : block.provider === 'vimeo' ? (
        <iframe
          src={`https://player.vimeo.com/video/${block.id}?badge=0&autopause=0`}
          title={block.caption ?? 'Project video'}
          frameborder="0"
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen
        ></iframe>
      ) : block.provider === 'onelineplayer' ? (
        <iframe
          src={onelinerSrc(block.src, { poster: block.poster })}
          title={block.caption ?? 'Project video'}
          frameborder="0"
          scrolling="no"
          allow="autoplay;fullscreen"
          allowfullscreen
        ></iframe>
      ) : (
        <video
          src={dropboxUrl(block.src)}
          poster={block.poster ?? undefined}
          controls
          playsinline
          preload="metadata"
          autoplay={block.autoplay || undefined}
          muted={block.muted || undefined}
          loop={block.loop || undefined}
        ></video>
      )}
    </div>
    {block.caption && <p class="block-caption label">{block.caption}</p>}
  </div>
)}

{blockType === 'widescreen-video' && (
  <div class="block-widescreen-video" data-animate="fade-up" style={block.aspectRatio ? `--aspect: ${block.aspectRatio}` : undefined}>
    <div class="widescreen-container">
      {block.poster ? (
        <button
          class="widescreen-poster"
          aria-label="Play video"
          data-src={onelinerSrc(dropboxUrl(block.url), {
            autoplay: block.autoplay === false ? 'false' : 'true',
            muted:    block.muted    ? 'true' : 'false',
            loop:     block.loop     ? 'true' : 'false',
          })}
        >
          <img src={block.poster} alt="" loading="lazy" decoding="async" />
          <span class="widescreen-play" aria-hidden="true">
            <span class="widescreen-play-btn">
              <svg viewBox="0 0 24 24" class="widescreen-play-icon" xmlns="http://www.w3.org/2000/svg">
                <path d="M8 5v14l11-7z" />
              </svg>
            </span>
          </span>
        </button>
      ) : (
        <iframe
          src={onelinerSrc(dropboxUrl(block.url), {
            autoplay: block.autoplay === false ? 'false' : 'true',
            muted:    block.muted ? 'true' : 'false',
            loop:     block.loop  ? 'true' : 'false',
          })}
          title={block.caption ?? 'Project video'}
          frameborder="0"
          scrolling="no"
          allow="autoplay;fullscreen"
          allowfullscreen
        ></iframe>
      )}
    </div>
    {block.caption && <p class="block-caption label">{block.caption}</p>}
  </div>
)}

{blockType === 'vertical-reel' && (
  <div class="block-vertical-reel">
    <div class="reel-video">
      <div class="video-container">
        <iframe
          src={onelinerSrc(dropboxUrl(block.video.url), {
            poster:   block.video.poster   ?? '',
            loop:     block.video.loop     ? 'true' : 'false',
            muted:    block.video.muted    ? 'true' : 'false',
            autoplay: block.video.autoplay ? 'true' : 'false',
          })}
          title={block.caption ?? 'Project video'}
          frameborder="0"
          scrolling="no"
          allow="autoplay;fullscreen"
          allowfullscreen
        ></iframe>
      </div>
    </div>
    <div class="reel-images">
      {(block.images ?? []).slice(0, 2).map((img: any) => (
        <div class="img-container img-reveal">
          <img src={img.src} alt={img.alt ?? ''} loading="lazy" decoding="async" />
        </div>
      ))}
    </div>
    {block.caption && <p class="block-caption label" style="grid-column: 1 / -1">{block.caption}</p>}
  </div>
)}

{blockType === 'text' && (
  <div class="block-text">

    {block.heading && (
      <h2 class="block-heading" data-animate="word-reveal">
        {splitWords(block.heading).map((word: string, i: number, arr: string[]) => (
          <span class="word-clip">
            <span class="word-inner">{word}{i < arr.length - 1 ? '\u00A0' : ''}</span>
          </span>
        ))}
      </h2>
    )}

    {block.body && (
      <div class="block-body" data-animate="line-reveal">
        {block.body.split('\n').filter((l: string) => l.trim()).map((line: string) => (
          <p class="text-line">{line}</p>
        ))}
      </div>
    )}

  </div>
)}
