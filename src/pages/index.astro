---
import Layout from '../layouts/Layout.astro'

const files = import.meta.glob('../content/projects/*.json', { eager: true })
const projects: any[] = Object.values(files)
  .map((m: any) => m.default)
  .sort((a: any, b: any) => b.year - a.year)

const visible = projects.filter((p: any) => !p.hidden)

/** Split title words into two visually balanced lines by character count */
function splitTitle(title: string): [string[], string[]] {
  const words = title.split(' ')
  if (words.length <= 2) return [words, []]
  const total = title.replace(/ /g, '').length
  let best = 1, bestDiff = Infinity
  let running = 0
  for (let i = 0; i < words.length - 1; i++) {
    running += words[i].length
    const diff = Math.abs(running - (total - running))
    if (diff < bestDiff) { bestDiff = diff; best = i + 1 }
  }
  return [words.slice(0, best), words.slice(best)]
}
---

<Layout>
  <div class="page">

    <section class="home-intro">
      <p class="home-intro-name" data-animate="fade-up">Benjamin Arnedo</p>
      <h1 class="home-intro-tagline" data-animate="fade-up">Photographer &amp;<br>Cinematographer</h1>
      <div class="btn-row home-intro-actions" data-animate="fade-up">
        <a href="/about" class="btn">About me</a>
        <a href="/how-i-work" class="btn btn--ghost">How I work &rarr;</a>
      </div>
    </section>

    <section class="work-grid" aria-label="Selected work">
      {visible.map((project: any) => (
        <a
          href={`/work/${project.slug}`}
          class="grid-item"
          data-size={project.gridSize ?? 'medium'}
          data-offset={project.gridOffset ? String(project.gridOffset) : undefined}
          style={`--aspect: ${project.coverAspect ?? '3/2'}${project.backgroundColor ? `; --project-bg: ${project.backgroundColor}` : ''}`}
          data-animate="fade-up"
        >
          <div class="img-container">
            <img
              src={project.cover}
              alt={project.title}
              loading="lazy"
              decoding="async"
              transition:name={`cover-${project.slug}`}
            />
            <div class="grid-item-overlay-bg"></div>
            <div class="grid-item-overlay">
              <p class="grid-item-title" data-title={project.title}>
                {splitTitle(project.title).map((line: string[]) => line.length > 0 && (
                  <span class="title-line">
                    {line.map((word: string) => (
                      <span class="word-clip"><span class="word-inner">{word}</span></span>
                    ))}
                  </span>
                ))}
              </p>
            </div>
          </div>
        </a>
      ))}
    </section>

  </div>
</Layout>
