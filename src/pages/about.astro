---
import Layout from '../layouts/Layout.astro'
import about from '../content/about.json'
import { marked } from 'marked'
---

<Layout title="About — Benjamin Arnedo">
  <div class="page">

    <div class="about-layout">
      <div class="about-text" data-animate="fade-up">
        <h1>{about.name}</h1>
        {about.bio.map((p: string) => (
          <div class="body-text" set:html={marked.parse(p)} />
        ))}
      </div>
      <div class="about-image img-reveal" data-animate="fade-up">
        <div class="img-container">
          <img src={about.portrait} alt={about.name} loading="eager" decoding="async" />
        </div>
      </div>
    </div>

    <div class="clients-section" data-animate="fade-up">
      <span class="label">Selected Clients</span>
      <ul class="clients-list" data-animate="stagger">
        {about.clients.map((client: string) => (
          <li>{client}</li>
        ))}
      </ul>
    </div>

  </div>
</Layout>
