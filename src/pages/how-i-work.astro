---
import Layout from '../layouts/Layout.astro'
import data from '../content/how-i-work.json'
import { ArrowRight } from 'lucide-astro'
import { marked } from 'marked'
---

<Layout title="Process — Benjamin Arnedo">
  <div class="page">
    <div class="how-layout">

      <h1 data-animate="fade-up">{data.title}</h1>
      <div class="how-intro body-text" data-animate="fade-up" set:html={marked.parse(data.intro)} />

      <div class="how-steps">
        {data.steps.map((step: any) => (
          <div class="how-step" data-animate="fade-up">
            <span class="step-number serif">{step.number}</span>
            <div class="step-content">
              <h3>{step.title}</h3>
              <div set:html={marked.parse(step.body ?? '')} />
            </div>
          </div>
        ))}
      </div>

      {data.cta && (
        <div class="how-cta" data-animate="fade-up">
          <span class="how-cta-text serif">{data.cta.text}</span>
          <a href={data.cta.link} class="nav-link">{data.cta.label}&thinsp;<ArrowRight size={13} style="display:inline;vertical-align:middle" /></a>
        </div>
      )}

    </div>
  </div>
</Layout>
