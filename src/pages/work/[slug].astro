---
import Layout from '../../layouts/Layout.astro'
import Block from '../../components/Block.astro'
import { CalendarDays, MapPin, User, Info, ArrowLeft, ArrowRight } from 'lucide-astro'

const files = import.meta.glob('../../content/projects/*.json', { eager: true })
const projects: any[] = Object.values(files)
  .map((m: any) => m.default)
  .sort((a: any, b: any) => b.year - a.year)

export function getStaticPaths() {
  const files = import.meta.glob('../../content/projects/*.json', { eager: true })
  const projects: any[] = Object.values(files).map((m: any) => m.default)
  return projects.map((project: any) => ({
    params: { slug: project.slug },
    props: { project },
  }))
}

const { project } = Astro.props as { project: any }
const idx = projects.findIndex((p: any) => p.slug === project.slug)
const nextProject = projects.length > 1 ? projects[(idx + 1) % projects.length] as any : null
const info = project.info ?? {}

// Build page background — gradient if secondary present
const bgColor = project.backgroundColor
const bgSecondary = project.backgroundColorSecondary
const pageBg = bgColor
  ? bgSecondary
    ? `linear-gradient(135deg, ${bgColor}, ${bgSecondary})`
    : bgColor
  : undefined

const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  creator: { '@type': 'Person', name: 'Benjamin Arnedo' },
  ...(project.info?.about ? { description: project.info.about } : {}),
  ...(project.year ? { dateCreated: String(project.year) } : {}),
  ...(project.cover ? { image: `https://benjaminarnedo.com${project.cover}` } : {}),
  ...(info.client ? { sponsor: { '@type': 'Organization', name: info.client } } : {}),
}
---

<Layout title={`${project.title} — Benjamin Arnedo`} description={info.about} pageBackground={bgColor} textColor={project.textColor} highlightColor={project.highlightColor} jsonLd={projectSchema} ogImage={project.cover}>
  <div class="page project-page" style={pageBg ? `--color-bg: ${bgColor}; background: ${pageBg}` : ''}>

    <!-- Cover image — morphs from grid thumbnail via view transition -->
    <div class="cover-transition" style={`--aspect: ${project.coverAspect ?? '16/9'}`}>
      <div class="img-container">
        <img
          src={project.cover}
          alt={project.title}
          loading="eager"
          decoding="async"
          transition:name={`cover-${project.slug}`}
        />
      </div>
      <!-- Back button — overlaid top-left of cover image -->
      <div class="project-back" data-animate="fade-up">
        <a href="/" class="nav-link" style="--pill-bg:var(--pill-base-bg);--pill-text:var(--pill-base-text)"><ArrowLeft size={13} style="display:inline;vertical-align:middle;margin-right:0.3em" /> All projects</a>
      </div>
    </div>

    <!-- Title + category -->
    <header class="project-header" data-animate="fade-up">
      <h1 class="project-title">{project.title}</h1>
      <div class="project-meta">
        <p class="label">{project.category}</p>
        <p class="label">{project.year}</p>
      </div>
    </header>

    <!-- Services -->
    {project.services?.length > 0 && (
      <div class="project-services" data-animate="fade-up">
        <span class="project-services-label label">Services</span>
        <ul class="project-services-list" role="list">
          {project.services.map((service: string) => (
            <li>
              <a href={`/?service=${encodeURIComponent(service)}`} class="service-pill">
                {service}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Project info strip -->
    {(info.about || info.date || info.place || info.client) && (
      <div class="project-info" data-animate="fade-up">
        {info.about && (
          <div class="project-info-item project-info-item--about">
            <span class="project-info-label"><Info size={11} class="info-icon" /> About</span>
            <span class="project-info-value">{info.about}</span>
          </div>
        )}
        {info.date && (
          <div class="project-info-item">
            <span class="project-info-label"><CalendarDays size={11} class="info-icon" /> Date</span>
            <span class="project-info-value">{info.date}</span>
          </div>
        )}
        {info.place && (
          <div class="project-info-item">
            <span class="project-info-label"><MapPin size={11} class="info-icon" /> Place</span>
            <span class="project-info-value">{info.place}</span>
          </div>
        )}
        {info.client && (
          <div class="project-info-item">
            <span class="project-info-label"><User size={11} class="info-icon" /> Client</span>
            <span class="project-info-value">{info.client}</span>
          </div>
        )}
      </div>
    )}

    <!-- Content blocks -->
    <div class="project-content">
      {(project.blocks ?? []).map((block: any) => (
        <Block block={block} />
      ))}
    </div>

    <!-- Next project -->
    {nextProject && (
      <div class="project-next-wrap">
        <a href={`/work/${nextProject.slug}`} class="project-next">
          <span class="project-next-label">Next</span>
          <span class="project-next-sep">/</span>
          <span class="project-next-title">{nextProject.title}</span>
          <ArrowRight size={13} />
        </a>
      </div>
    )}

  </div>
</Layout>
