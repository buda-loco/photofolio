tina/__generated__/*
# Keep the generated types/queries committed so the Tina client can be built
# from env vars at runtime (the generated client.ts has a baked token + local
# cacheDir, so we construct our own client in src/lib/tinaClient.ts instead).
!tina/__generated__/types.ts
tsconfig.tsbuildinfo

# editor swap files
*.swp

# Local-only job hunt control panel. This repo is PUBLIC — the dashboard holds
# salary targets, market analysis and personal job-search strategy, so it must
# never be committed. The notFound() gate in page.tsx keeps it off the built
# site; this keeps the source off GitHub.
src/app/dashboard/

# Showreel pipeline — holds the Dropbox token and generated caches
scripts/showreel/config.sh
scripts/showreel/.ca-bundle.pem
scripts/showreel/.links.json
