{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "paths": {
      "@tool/*": ["../src/app/presentations/placeworks/_components/tool/*"],
      "@deck/*": ["../src/app/presentations/placeworks/*"]
    }
  },
  // Only this app's own src is in the project; the aliased tool sources get
  // typechecked transitively through imports (which keeps their *.test.ts —
  // and its vitest dependency — out of this compile).
  "include": ["src"]
}
