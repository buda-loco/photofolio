{
  "name": "placeworks-brand-asset-tool",
  "productName": "PlaceWorks Brand Asset Tool",
  "description": "Standalone desktop version of the PlaceWorks brand asset generator",
  "version": "0.1.0",
  "private": true,
  "author": "Benjamin Arnedo",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5199 && VITE_DEV_SERVER_URL=http://127.0.0.1:5199 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.benjaminarnedo.placeworks-tool",
    "productName": "PlaceWorks Brand Asset Tool",
    "artifactName": "PlaceWorks-Brand-Asset-Tool-${version}-${arch}.${ext}",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
