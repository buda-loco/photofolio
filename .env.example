TINA_PUBLIC_CLIENT_ID=your-client-id-here
TINA_TOKEN=your-token-here
GITHUB_BRANCH=main

# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX).
# Leave unset locally — the tag only renders when this is present, which keeps
# dev traffic out of the property. Set it in Vercel for production.
NEXT_PUBLIC_GA_ID=
